# Environment Variables for Render Deployment

# Add these to Render Dashboard → Environment Variables:

DEBUG=False

SECRET_KEY=replace-with-a-long-random-secret

ALLOWED_HOSTS=tunivisions-iset-kairouan.onrender.com

# Admin Access Control (set to False to restrict to staff only)
OPEN_ADMIN_ACCESS=False

# Admin Account Creation (for create_admin command)
ADMIN_USERNAME=admin
ADMIN_EMAIL=replace-with-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Database URL (Render sets this automatically)
# DATABASE_URL=postgresql://...

# CSRF Configuration
CSRF_TRUSTED_ORIGINS=https://tunivisions-iset-kairouan.onrender.com

# Optional AI integration
GEMINI_API_KEY=
USE_AI_API=False
